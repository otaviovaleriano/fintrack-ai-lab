# Supabase project connection.
# These values are safe to expose in the browser bundle by design — see the
# Phase 0 discussion in our migration plan for why the publishable key does
# not need to be kept secret. Row Level Security, not key secrecy, is what
# protects the data.
#
# CRA only bundles variables prefixed with REACT_APP_ into the client build.

REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Never add a secret/service-role key here. This file (and the real .env it
# templates) is for browser-safe values only.
